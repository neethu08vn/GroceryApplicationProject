<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross browser testing">

	<test thread-count="5" name="chrome Test">
		<parameter name="browsers" value="Chrome"></parameter>
		<classes>
			<class name="testscripts.LoginTest">
				<methods>
					<include
						name="verifyUserLoginWithValidUsernameAndInvalidPassword"></include>
				</methods>
			</class>
		</classes>
	</test> <!--
	Test -->

	<test thread-count="5" name="firefox Test">
		<parameter name="browsers" value="firefox"></parameter>
		<classes>
			<class name="testscripts.LoginTest">
				<methods>
					<include
						name="verifyUserLoginWithValidUsernameAndInvalidPassword"></include>
				</methods>
			</class>
		</classes>
	</test> <!--
	Test -->
</suite> <!--
Suite -->
